profileVersion = "v1"
savefile = "NR0000.co2"
start_online = false

[[supports]]
game = "nightreign"

# Seamless Co-op is not part of this build, so nothing here points at a DLL that is missing:
# launching a profile whose native does not exist fails. If you launch THIS profile, put
# nrsc.dll in ./SeamlessCoop/ and uncomment the block below. If the profile you already play
# loads Seamless Co-op, keep that entry and leave this one commented out - one nrsc, not two.
#
# [[natives]]
# path = "./SeamlessCoop/nrsc.dll"
# load_early = true

# ---------------------------------------------------------------------------
# DoubleBOSS - Any Mode build. One package per file family under ./mod/, so a
# part that clashes with another mod can be switched off here instead of
# removing the whole mod. No two packages contain the same game path, so order
# does not matter. CONFLICTS.md says what to turn off and what must be merged
# by hand.
# ---------------------------------------------------------------------------

# The mod itself: the four recompiled arena scripts. Required.
[[packages]]
id = "db-events"
path = "./mod/01-events"

# Arena data: the extra Nightlord / invader placements (.msb) and the arena
# point lights (.btl). Clashes with any other mod that replaces the same maps.
[[packages]]
id = "db-maps"
path = "./mod/02-maps"

# regulation.bin for the added NPCs. Clashes with every other regulation.bin
# mod: merge the two files (see CONFLICTS.md) and put the result in this folder,
# or set enabled = false if another package already loads a merged file.
[[packages]]
id = "db-params"
path = "./mod/03-params"

# Boss name strings. Cosmetic: disabling it only loses the custom names.
[[packages]]
id = "db-text"
path = "./mod/04-text"

# The author's copy of common_func.emevd.dcx. It is the stock file for this
# build - it contains none of the chain's events or flags - and common_func is
# the file other gameplay mods most often replace, so it is off by default.
# Set enabled = true if the chain never starts and no other mod ships this file.
[[packages]]
id = "db-common-func"
path = "./mod/05-common-func"
enabled = false
